*label010652|
[chara fn=kisakiB_ar left=250 top=-50 tm=701]

*label010653|
[pv char="kisaki" voice=kisaki_547.ogg]
[name fn=妃]「そうですね。前向きに考えましょうか」[ps]

*label010654|
